# ==============================================================================
# Environment Configuration Example
# Copy this file to .env and customize for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Environment
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'production', or 'test'.
# In production, demo seeding is prohibited and email provider rules are enforced.
NODE_ENV=production

# Port on which the Fastify backend API listens.
PORT=4000

# Network host address to bind the server to (0.0.0.0 for Docker/containers).
HOST=0.0.0.0

# Canonical public base URL for links in verification emails, invites, and web assets.
PUBLIC_URL=http://localhost:4000

# Optional CORS origin for browser requests from separate frontend origins.
# In production, CORS is OFF by default (same-origin web assets served directly).
# Set WEB_URL only if accessing the API from a distinct frontend domain/port.
WEB_URL=

# Public signup registration mode: 'open' or 'invite_only'.
# Defaults to 'invite_only' in production and 'open' in development.
SIGNUP_MODE=invite_only

# Optional filesystem path to pre-built web client distribution folder.
# Defaults to apps/web/dist relative to repository root.
WEB_DIST_PATH=apps/web/dist

# ------------------------------------------------------------------------------
# 2. Database Connections (PostgreSQL) - [SECRETS]
# ------------------------------------------------------------------------------
# Primary database connection string for application runtime queries (pooled). [SECRET]
# DATABASE_URL is the only required DB variable.
DATABASE_URL=postgres://user:password@localhost:5432/config_platform?sslmode=disable

# Optional direct, unpooled PostgreSQL connection string for DDL migrations & advisory locking. [SECRET]
# Defaults to DATABASE_URL if omitted.
DATABASE_URL_DIRECT=

# Optional dedicated test database connection string used when running tests. [SECRET]
# Defaults to postgresql://postgres:postgres@localhost:5432/config_platform_test if omitted.
# Note: Test startup refuses to run if TEST_DATABASE_URL equals DATABASE_URL or points to the same host & database.
TEST_DATABASE_URL=

# Statement execution timeout in milliseconds applied via SET LOCAL in transactions.
STATEMENT_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 3. Security, Cookies & Networking - [SECRETS]
# ------------------------------------------------------------------------------
# Secret key used to sign and verify session cookies (minimum 32 random characters). [SECRET]
COOKIE_SECRET=replace-with-at-least-32-characters-cryptographic-random-secret-key!

# Reverse proxy trust setting for Fastify ('true', 'false', or IP/CIDR string).
# Enables accurate client IP detection via X-Forwarded-For for the rate limiter.
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 4. Email Delivery & Verification - [SECRETS]
# ------------------------------------------------------------------------------
# Enforce email verification before users can log in ('true' or 'false').
# In production, must be explicitly 'false' if no email provider is configured.
REQUIRE_EMAIL_VERIFICATION=false

# API key for Resend email delivery service (https://resend.com). [SECRET]
# Configure either RESEND_API_KEY or SMTP_URL for production emails.
RESEND_API_KEY=

# SMTP connection URI for email delivery (alternative to Resend). [SECRET]
# Example: smtp://username:password@smtp.mailgun.org:587
SMTP_URL=

# Sender address shown in the 'From' header of outgoing verification & invite emails.
# REQUIRED in production when RESEND_API_KEY or SMTP_URL is configured.
# Scheduled report emails use it too ("Workspace Name" <EMAIL_FROM>), unless a workspace
# set up its own mail server under Settings → Email.
EMAIL_FROM=noreply@example.com

# Key that encrypts workspace mail server passwords (Settings → Email) in the database. [SECRET]
# REQUIRED in production before any workspace saves its own mail server. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later means workspaces must re-enter their mail server password.
SETTINGS_ENCRYPTION_KEY=

# Set to 'off' to stop this server from sending scheduled reports (e.g. extra servers or staging).
REPORT_SCHEDULER=on

# ------------------------------------------------------------------------------
# 5. One-time Initial Owner Bootstrap (Optional CLI Env Vars)
# ------------------------------------------------------------------------------
# Used by `pnpm bootstrap:owner` if running non-interactively in CI/provisioning.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_TENANT_NAME="Primary Workspace"

# ------------------------------------------------------------------------------
# 6. Client / Frontend Build Settings
# ------------------------------------------------------------------------------
# API base URL path or host used by Vite web client to reach the API (default: /api).
VITE_API_URL=/api
